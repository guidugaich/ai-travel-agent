{
  "name": "ai-travel-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "prepare": "lefthook install",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm deps:check && pnpm test && pnpm secrets:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "deps:check": "depcruise packages apps",
    "deps:graph": "depcruise packages apps --output-type mermaid --collapse \"^(packages|apps)/[^/]+\"",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "secrets:check": "secretlint \"**/*\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "lefthook": "2.1.16",
    "prettier": "3.9.9",
    "secretlint": "13.0.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
