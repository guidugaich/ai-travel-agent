# Copy this file to .env, which git ignores, and fill it in.

# From BotFather. Anyone with this token controls the bot, so never share or commit it.
TELEGRAM_BOT_TOKEN=

# Telegram ids that get answers, comma-separated. Leave it empty at first:
# message the bot and it tells you your id.
ALLOWED_TELEGRAM_IDS=

# The language model, through any server that speaks the chat completions format.
# Leave both empty to use the stand-in model. For Ollama on this machine:
# LLM_BASE_URL=http://localhost:11434/v1
LLM_BASE_URL=
LLM_MODEL=

# Only for hosted providers. Anyone with it can spend on your account, so never share or commit it.
LLM_API_KEY=
